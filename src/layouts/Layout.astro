---
import { defaultStore } from '../store/store';
import {
  dismissedKey,
  eraDate,
  eraTheme,
  eraValue,
  serverEra,
  themeFor,
} from '../lib/era';
import '../styles/global.css';

const state = defaultStore.getState();
const currentEra = serverEra(Astro.url);
const currentTheme = themeFor(currentEra, state.theme);
const currentFont = state.font;

const defaultImage = 'https://spider.jlopes.eu/spiderweb.jpg';

const {
  title = 'Spider Parser',
  description = 'Parse news articles and web pages with ease.',
  url = 'https://spider.jlopes.eu/',
  image = defaultImage,
  type = 'article',
  author = '',
  publishedTime = '',
  canonical = Astro.url.href,
  noindex = false,
} = Astro.props;

const isDefaultImage = image === defaultImage;

const siteGraph = [
  {
    '@type': 'WebSite',
    '@id': 'https://spider.jlopes.eu/#website',
    url: 'https://spider.jlopes.eu/',
    name: 'Spider Parser',
    description: 'Parse news articles and web pages with ease.',
  },
  {
    '@type': 'WebApplication',
    '@id': 'https://spider.jlopes.eu/#app',
    name: 'Spider Parser',
    url: 'https://spider.jlopes.eu/',
    description: 'A clean reader view for news articles and web pages.',
    applicationCategory: 'UtilityApplication',
    browserRequirements:
      'Requires a modern web browser with JavaScript enabled.',
    isPartOf: { '@id': 'https://spider.jlopes.eu/#website' },
  },
];

const articleNode =
  type === 'article' && title !== 'Spider Parser'
    ? {
        '@type': 'Article',
        '@id': `${canonical}#article`,
        headline: title,
        description,
        url: canonical,
        mainEntityOfPage: { '@id': canonical },
        ...(image !== defaultImage && { image }),
        ...(author && { author: { '@type': 'Person', name: author } }),
        ...(publishedTime && { datePublished: publishedTime }),
      }
    : null;

const graph = articleNode ? [...siteGraph, articleNode] : siteGraph;

---

<!doctype html>
<html
  lang="en"
  data-theme={currentTheme}
  data-font={currentFont}
  data-era={currentEra === 'none' ? undefined : currentEra}
>
  <head>
    <script
      is:inline
      define:vars={{ dismissedKey, eraDate, eraTheme, eraValue }}
    >
      const today = new Date();
      const inDate =
        today.getMonth() === eraDate.month &&
        today.getDate() === eraDate.day;

      const isDismissed = () => {
        try {
          return localStorage.getItem(dismissedKey) === today.toDateString();
        } catch {
          return false;
        }
      };

      if (inDate && !isDismissed()) {
        document.documentElement.dataset.era = eraValue;
        document.documentElement.dataset.theme = eraTheme;
      }
    </script>
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" href="/llms.txt" title="LLMs.txt" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#001e29" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />

    <link rel="me" href="https://bsky.app/profile/jlopes.eu" />
    <link rel="me" href="https://jlopes.eu/about/" />
    <link rel="me" href="acct:jlopes@jlopes.eu" />
    <meta name="fediverse:creator" content="@jlopes@jlopes.eu" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jelo" />
    <meta name="twitter:creator" content="@jelo" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={title} />
    {
      isDefaultImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:site_name" content="Spider Parser" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    {
      type === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === 'article' && author && (
        <meta property="article:author" content={author} />
      )
    }
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'max-snippet:-1, max-image-preview:large, max-video-preview:-1'
      }
    />
    <script
      id="app-jsonld"
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': graph,
      })}
    />

  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      import { defaultStore } from '../store/store';
      import { listenForKonami, themeFor } from '../lib/era';
      import { enterEra } from '../lib/travel';

      defaultStore.setState({
        initialized: true,
        showTranslateBar: false,
      });

      listenForKonami(enterEra);

      function updateTheme() {
        const state = defaultStore.getState();
        const era = state.era;
        const theme = themeFor(era, state.theme);
        const font = state.font;
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-font', font);

        if (era === 'none') {
          document.documentElement.removeAttribute('data-era');
        } else {
          document.documentElement.setAttribute('data-era', era);
        }

        const meta = document.querySelector('meta[name="theme-color"]');
        const base = getComputedStyle(document.documentElement)
          .getPropertyValue('--color-base-100')
          .trim();
        if (meta && base) meta.setAttribute('content', base);
      }

      updateTheme();
      defaultStore.subscribe(updateTheme);
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }

  html {
    min-height: 100%;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-base-100);
    color: var(--color-primary);
    border: 2px solid currentColor;
    border-radius: 0 0 0.5rem 0;
  }

  .skip-link:focus {
    left: 0;
  }
</style>
